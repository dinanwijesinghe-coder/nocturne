{
  "entities": {
    "UserProfileDoc": {
      "title": "UserProfileDoc",
      "description": "Authenticated listener profile, social graph references, and playback preferences synced across devices.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "username": { "type": "string", "minLength": 1, "maxLength": 40 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "bio": { "type": "string", "minLength": 0, "maxLength": 240 },
        "avatarUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "likedTrackIds": { "type": "array" },
        "followedArtistIds": { "type": "array" },
        "followedFriendIds": { "type": "array" },
        "audioQuality": { "type": "string", "enum": ["low", "normal", "high", "lossless"] },
        "dataSaver": { "type": "boolean" },
        "crossfadeSeconds": { "type": "number" },
        "playbackSpeed": { "type": "number" },
        "autoplaySimilar": { "type": "boolean" },
        "recentSearches": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName", "createdAt", "updatedAt"]
    },
    "LikedTrackItem": {
      "title": "LikedTrackItem",
      "description": "Track metadata for a user's synced liked song.",
      "type": "object",
      "properties": {
        "trackId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "artist": { "type": "string", "minLength": 1, "maxLength": 160 },
        "artistId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "genre": { "type": "string", "minLength": 1, "maxLength": 80 },
        "duration": { "type": "number" },
        "artworkUrl": { "type": "string", "minLength": 0, "maxLength": 600 },
        "streamUrl": { "type": "string", "minLength": 0, "maxLength": 800 },
        "source": { "type": "string", "enum": ["audius", "local", "podcast", "studio"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["trackId", "ownerUid", "title", "artist", "genre", "duration", "source", "createdAt"]
    },
    "FollowedArtistItem": {
      "title": "FollowedArtistItem",
      "description": "Artist profile followed by a listener and synced across devices.",
      "type": "object",
      "properties": {
        "artistId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "handle": { "type": "string", "minLength": 1, "maxLength": 80 },
        "avatarUrl": { "type": "string", "minLength": 0, "maxLength": 600 },
        "followersCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["artistId", "ownerUid", "name", "handle", "followersCount", "createdAt"]
    },
    "CollaborativePlaylist": {
      "title": "CollaborativePlaylist",
      "description": "Personal or real-time collaborative playlist synced across members and devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 0, "maxLength": 300 },
        "coverUrl": { "type": "string", "minLength": 0, "maxLength": 600 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "isCollaborative": { "type": "boolean" },
        "inviteCode": { "type": "string", "minLength": 0, "maxLength": 24 },
        "memberUids": { "type": "array" },
        "collaboratorNames": { "type": "array" },
        "trackIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerUid", "ownerName", "isCollaborative", "memberUids", "trackIds", "createdAt", "updatedAt"]
    },
    "PlaylistTrackItem": {
      "title": "PlaylistTrackItem",
      "description": "Track metadata entry inside a playlist subcollection for cross-device and multi-user playback.",
      "type": "object",
      "properties": {
        "trackId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "artist": { "type": "string", "minLength": 1, "maxLength": 160 },
        "artistId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "genre": { "type": "string", "minLength": 1, "maxLength": 80 },
        "duration": { "type": "number" },
        "artworkUrl": { "type": "string", "minLength": 0, "maxLength": 600 },
        "streamUrl": { "type": "string", "minLength": 0, "maxLength": 800 },
        "source": { "type": "string", "enum": ["audius", "local", "podcast", "studio"] },
        "addedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["trackId", "title", "artist", "genre", "duration", "source", "addedByUid", "createdAt"]
    },
    "PlaylistInvite": {
      "title": "PlaylistInvite",
      "description": "Single-code invite pointer mapping a shareable invite code to a collaborative playlist.",
      "type": "object",
      "properties": {
        "inviteCode": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "playlistId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteCode", "playlistId", "ownerUid", "isActive", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfileDoc" },
      "description": "Owner-only listener profile, preferences, and synced ID lists."
    },
    "/users/{userId}/likedTracks/{trackId}": {
      "schema": { "$ref": "#/entities/LikedTrackItem" },
      "description": "Synced liked tracks metadata for the user."
    },
    "/users/{userId}/followedArtists/{artistId}": {
      "schema": { "$ref": "#/entities/FollowedArtistItem" },
      "description": "Synced followed artists metadata for the user."
    },
    "/playlists/{playlistId}": {
      "schema": { "$ref": "#/entities/CollaborativePlaylist" },
      "description": "Personal and real-time collaborative playlists."
    },
    "/playlists/{playlistId}/items/{trackId}": {
      "schema": { "$ref": "#/entities/PlaylistTrackItem" },
      "description": "Synced track metadata items inside each playlist."
    },
    "/playlistInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/PlaylistInvite" },
      "description": "Invite code lookup records for joining collaborative playlists."
    }
  }
}
